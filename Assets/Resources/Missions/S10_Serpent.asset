      figurePath: []
      lanternLine: []
    - id: rec3
      label: A SIGNED ORDER
      point: {x: 13, y: 0, z: -9}
      shape: 9
      speaker: RENZO
      line: '"Continue the search. The Kurogawa must be brought to the mountain.
