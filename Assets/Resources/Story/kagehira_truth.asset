  - subject: KAGACHI
    camera: 0
    duration: 4.5
    letterbox: 1
    speaker: KAGACHI
    line: With it, I am order. Without it, I am a man with an army, and armies end.
    voice: {fileID: 0}
    applyTheme: 0
    theme: 0
